---
import '../styles/global.css';
import { emExemplo } from '../lib/dados.mjs';
import { REPORTAR_ERRO } from '../lib/site.mjs';
const { titulo = 'Antes da Urna', descricao = 'Compare lado a lado os planos de governo do 2º turno presidencial de 2026, registrados no TSE. Independente e apartidário.', semIndice = false } = Astro.props;
const canonica = new URL(Astro.url.pathname, Astro.site);
const tituloCompleto = titulo === 'Antes da Urna' ? titulo : `${titulo} · Antes da Urna`;
---
<!doctype html>
<html lang="pt-BR">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{tituloCompleto}</title>
  <meta name="description" content={descricao} />
  <link rel="canonical" href={canonica} />
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  {semIndice && <meta name="robots" content="noindex" />}
  <meta property="og:type" content="website" />
  <meta property="og:site_name" content="Antes da Urna" />
  <meta name="twitter:card" content="summary" />
  <meta property="og:locale" content="pt_BR" />
  <meta property="og:title" content={tituloCompleto} />
  <meta property="og:description" content={descricao} />
  <meta property="og:url" content={canonica} />
  <meta name="theme-color" content="#17142B" />
  <script is:inline>
    // Antes da primeira pintura: ordem sorteada a cada visita e preferência de texto.
    (function () {
      var h = document.documentElement;
      h.className = 'js';
      h.dataset.ordem = Math.random() < 0.5 ? 'ab' : 'ba';
      try { if (localStorage.getItem('texto') === 'grande') h.dataset.texto = 'grande'; } catch (e) {}
    })();
  </script>
</head>
<body>
  <a class="pular" href="#conteudo">Pular para o conteúdo</a>
  <header class="topo">
    <div class="topo-in">
      <a class="marca" href="/"><span class="marca-cores" aria-hidden="true"><i></i><i></i></span>Antes da Urna</a>
      <nav class="menu" aria-label="Seções">
        <a href="/#areas">Por área</a>
        <a href="/#busca">Buscar</a>
        <a href="/#quiz">Às cegas</a>
        <a href="/como-fizemos/">Como fizemos</a>
        <button type="button" class="btn-texto" id="btn-texto" aria-pressed="false">A+ Texto maior</button>
      </nav>
    </div>
  </header>
  {emExemplo && <div class="aviso-exemplo" role="note">Conteúdo de exemplo: os planos ainda não foram extraídos nem revisados.</div>}
  <main id="conteudo"><slot /></main>
  <script is:inline>
    // Ordem sorteada a cada visita: reordena o DOM (leitura e Tab acompanham o visual).
    if (document.documentElement.dataset.ordem === 'ba') {
      document.querySelectorAll('[data-sorteio]').forEach(function (el) {
        var b = el.querySelector(':scope > [data-lado="b"]');
        if (b) el.prepend(b);
      });
    }
  </script>
  <footer class="rodape">
    <div class="rodape-in">
      <span>Antes da Urna · projeto independente, sem vínculo com partidos ou campanhas.</span>
      <a href={REPORTAR_ERRO} rel="noopener">Encontrou um erro? Fale com a gente</a>
    </div>
  </footer>
  <script>
    const btn = document.getElementById('btn-texto')!;
    const raiz = document.documentElement;
    const atualizar = () => {
      const grande = raiz.dataset.texto === 'grande';
      btn.setAttribute('aria-pressed', String(grande));
    };
    btn.addEventListener('click', () => {
      const grande = raiz.dataset.texto !== 'grande';
      if (grande) raiz.dataset.texto = 'grande'; else delete raiz.dataset.texto;
      try { localStorage.setItem('texto', grande ? 'grande' : 'normal'); } catch {}
      atualizar();
    });
    atualizar();
  </script>
</body>
</html>
