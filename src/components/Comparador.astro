---
import { AREAS } from '../lib/dados.mjs';
import { BLOCOS } from '../lib/areas.mjs';
import Colunas from './Colunas.astro';
---
<section id="areas" class="faixa" aria-labelledby="t-areas">
  <div class="miolo">
    <div>
      <h2 class="h2" id="t-areas">Escolha um tema</h2>
      <p class="suave">Com JavaScript ligado, a ordem dos candidatos é sorteada a cada visita.</p>
    </div>
    <div class="abas" role="group" aria-label="Blocos de temas">
      {BLOCOS.map((b, i) => <button type="button" class="aba aba-bloco" data-bloco={b.nome} aria-pressed={i === 0 ? 'true' : 'false'}>{b.nome}</button>)}
    </div>
    {BLOCOS.map((b, i) => (
      <div class="abas abas-temas" role="group" aria-label={`Temas de ${b.nome}`} data-temas-do-bloco={b.nome} hidden={i !== 0}>
        {b.areas.map((slug, j) => <button type="button" class="aba" data-aba={slug} aria-pressed={i === 0 && j === 0 ? 'true' : 'false'}>{AREAS.find((a) => a.slug === slug)?.nome}</button>)}
      </div>
    ))}
    {AREAS.map((a, i) => (
      <div class:list={['painel', { ativo: i === 0 }]} data-painel={a.slug}>
        <h3 class="painel-titulo">{a.nome}</h3>
        <Colunas area={a.nome} nivel={4} />
        <p class="suave"><a class="link-bloco" href={`/tema/${a.slug}/`}>Abrir página só deste tema (para compartilhar)</a></p>
      </div>
    ))}
  </div>
</section>
<script>
  const abas = document.querySelectorAll<HTMLButtonElement>('[data-aba]');
  const blocos = document.querySelectorAll<HTMLButtonElement>('[data-bloco]');
  const grupos = document.querySelectorAll<HTMLElement>('[data-temas-do-bloco]');
  const paineis = document.querySelectorAll<HTMLElement>('[data-painel]');
  const mostrar = (slug: string) => {
    abas.forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.aba === slug)));
    paineis.forEach((p) => p.classList.toggle('ativo', p.dataset.painel === slug));
  };
  const mostrarBloco = (nome: string) => {
    blocos.forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.bloco === nome)));
    grupos.forEach((g) => { g.hidden = g.dataset.temasDoBloco !== nome; });
    const primeiro = document.querySelector<HTMLButtonElement>(`[data-temas-do-bloco="${CSS.escape(nome)}"] [data-aba]`);
    if (primeiro) mostrar(primeiro.dataset.aba!);
  };
  abas.forEach((b) => b.addEventListener('click', () => mostrar(b.dataset.aba!)));
  blocos.forEach((b) => b.addEventListener('click', () => mostrarBloco(b.dataset.bloco!)));
</script>
