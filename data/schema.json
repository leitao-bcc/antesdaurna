{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://antesdaurna.com.br/data/schema.json",
  "title": "Plano de governo de um candidato",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "letra",
    "nome",
    "status",
    "cobertura",
    "propostas"
  ],
  "properties": {
    "id": {
      "enum": [
        "a",
        "b"
      ]
    },
    "letra": {
      "enum": [
        "A",
        "B"
      ]
    },
    "nome": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "enum": [
        "exemplo",
        "rascunho",
        "revisado"
      ]
    },
    "fonte": {
      "$ref": "#/$defs/fonte"
    },
    "cobertura": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/cobertura"
      },
      "description": "Todas as áreas de src/lib/areas.mjs (o validador exige todas e só elas)."
    },
    "propostas": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/proposta"
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "exemplo"
          }
        },
        "required": [
          "status"
        ]
      },
      "else": {
        "required": [
          "fonte"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "revisado"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "properties": {
          "fonte": {
            "type": "object",
            "required": [
              "revisado_por",
              "revisado_em"
            ]
          }
        }
      }
    }
  ],
  "$defs": {
    "cobertura": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "consta",
        "revisado"
      ],
      "properties": {
        "consta": {
          "type": "boolean"
        },
        "revisado": {
          "type": "boolean"
        }
      }
    },
    "fonte": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "url_tse",
        "sha256_pdf",
        "baixado_em",
        "paginas_total"
      ],
      "properties": {
        "url_tse": {
          "type": "string",
          "format": "uri",
          "pattern": "^https://(divulgacandcontas|www)\\.tse\\.jus\\.br/[^@\\s]*$",
          "description": "Página da candidatura no DivulgaCandContas."
        },
        "sha256_pdf": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "baixado_em": {
          "type": "string",
          "format": "date"
        },
        "paginas_total": {
          "type": "integer",
          "minimum": 1
        },
        "tse_sq_candidato": {
          "type": "string"
        },
        "numero": {
          "type": "string"
        },
        "partido": {
          "type": "string"
        },
        "revisado_por": {
          "type": "string",
          "minLength": 1
        },
        "revisado_em": {
          "type": "string",
          "format": "date"
        },
        "url_pdf": {
          "type": "string",
          "format": "uri",
          "pattern": "^https://(divulgacandcontas|www)\\.tse\\.jus\\.br/[^@\\s]*$",
          "description": "Endereço direto do PDF do plano, se houver. Se existir, link_pdf das propostas deve ser igual."
        },
        "ocr": {
          "type": "boolean",
          "description": "true se o texto veio de OCR (citação literal menos confiável)."
        },
        "trechos_conferidos_em": {
          "type": "string",
          "format": "date"
        },
        "trechos_conferidos_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$",
          "description": "Selo gravado por `npm run conferir`; validar --estrito recalcula."
        }
      }
    },
    "proposta": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "area",
        "titulo",
        "resumo",
        "trecho_original",
        "pagina",
        "link_pdf"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(-[a-z0-9]+)*-[0-9]{2,}$"
        },
        "area": {
          "type": "string",
          "minLength": 1,
          "description": "Uma das áreas de src/lib/areas.mjs (o validador injeta o enum)."
        },
        "titulo": {
          "type": "string",
          "minLength": 1
        },
        "resumo": {
          "type": "string",
          "minLength": 1
        },
        "trecho_original": {
          "type": "string",
          "minLength": 1
        },
        "pagina": {
          "type": "integer",
          "minimum": 0,
          "description": "Página do PDF, a partir de 1. 0 só é aceito em exemplo/rascunho; conteúdo revisado exige >= 1."
        },
        "link_pdf": {
          "type": "string",
          "format": "uri",
          "pattern": "^https://(divulgacandcontas|www)\\.tse\\.jus\\.br/[^@\\s]*$"
        },
        "etiquetas": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string" },
          "description": "Público da medida (src/lib/areas.mjs, ETIQUETAS; o validador injeta o enum). Opcional; não substitui o tema."
        }
      }
    }
  }
}
